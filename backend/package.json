{
  "name": "Quote APP API",
  "version": "1.0.0",
  "private": true,
  "description": "Simple quote API",
  "main": "index.js",
  "scripts": {
    "start": "node migrate.js && node index.js",
    "migrate": "node migrate.js",
    "dev": "node --import ./instrumentation.js --watch index.js",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  }
}
